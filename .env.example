# ===========================================
# Iron Loot - Environment Configuration
# ===========================================
# Copy this file to .env and adjust values as needed
# NEVER commit .env to version control

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development
# Options: development, qa, production

# -------------------------------------------
# API Configuration
# -------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=ironloot_db
DB_USER=ironloot
DB_PASSWORD=ironloot_dev

# Full connection URL (auto-constructed in docker-compose)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -------------------------------------------
# Redis
# -------------------------------------------
# PT-137 — `REDIS_URL` es el UNICO contrato. `REDIS_HOST`/`REDIS_PORT` se retiraron: dos de los
# cuatro clientes los leian con reserva `localhost` mientras el compose declaraba solo la URL, asi
# que el sistema funcionaba por un `src/api/.env` que no esta en git (F-135-A).
# REDIS_PASSWORD=  # Uncomment if Redis auth is enabled

# Full connection URL
REDIS_URL=redis://redis:6379

# -------------------------------------------
# Logging & Observability
# -------------------------------------------
LOG_LEVEL=debug
# Options: debug, info, warn, error
# Note: debug is only enabled in development

TRACE_ENABLED=true
# Enable trace_id propagation

# -------------------------------------------
# Service URLs (PT-033)
# -------------------------------------------
# BASE_URL: Public BASE site URL. Used by the API's EmailService to build auth
# email links (verify-email, reset-password). Must point to the BASE frontend.
# Local dev:   http://localhost:5174
# Docker:      http://base.localhost  (set in docker-compose environment)
# Production:  https://www.ironloot.com (or your public domain)
BASE_URL=http://localhost:5174

# -------------------------------------------
# CORS (PT-029)
# -------------------------------------------
# Comma-separated list of allowed origins. REQUIRED in production.
# Empty → allow all (development only). Production WILL fail startup if empty.
ALLOWED_ORIGINS=http://base.localhost,http://client.localhost,http://localhost:5174,http://localhost:5175

# -------------------------------------------
# SSO / Cookie (PT-034)
# -------------------------------------------
# Cross-subdomain SSO: set domain WITH leading dot for cookie propagation.
# IMPORTANT: .localhost does NOT work — Chrome/Edge reject cookies for public suffixes (RFC 6265).
# Docker dev (requires hosts file entries for ironloot.local): .ironloot.local
# -------------------------------------------
# PT-088 — Dominio publico: UNA sola fuente
# -------------------------------------------
# Las URLs entre sitios (BASE -> CLIENT, y las de retorno de las pasarelas) se DERIVAN de estas
# dos variables en docker-compose. No se escriben una a una: cambiar de entorno es cambiar estas
# dos lineas.
#   local       PUBLIC_SCHEME=http   PUBLIC_DOMAIN=ironloot.local
#   produccion  PUBLIC_SCHEME=https  PUBLIC_DOMAIN=ironloot.com
#
# NO usar `localhost` como PUBLIC_DOMAIN: es un dominio de uso especial y los navegadores
# RECHAZAN una cookie con `Domain=.localhost`, de modo que la sesion no cruzaria de BASE a
# CLIENT. Con `localhost:<puerto>` el problema no se ve —el puerto no delimita cookies— y por
# eso aparece justo al pasar a subdominios.
PUBLIC_SCHEME=http
PUBLIC_DOMAIN=ironloot.local

# Puerto en el que nginx publica en el host. Debe ser 80 para que `subdominio.dominio` funcione
# sin puerto. Si el 80 esta ocupado: NGINX_HTTP_PORT=8081 y PUBLIC_DOMAIN=ironloot.local:8081,
# conservando los subdominios en vez de volver a `localhost:<puerto>`.
NGINX_HTTP_PORT=80

# Local dev puro (todos en localhost, puertos distintos): dejar vacío
# Production: .ironloot.com
# Hosts file entries needed for Docker dev (C:\Windows\System32\drivers\etc\hosts):
#   127.0.0.1  base.ironloot.local
#   127.0.0.1  client.ironloot.local
#   127.0.0.1  api.ironloot.local
#   127.0.0.1  admin.ironloot.local
COOKIE_DOMAIN=.ironloot.local
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# Admin API key — MUST be changed in production (PT-029 startup check enforces this)
ADMIN_API_KEY=dev-admin-key

# -------------------------------------------
# Security & Authentication
# -------------------------------------------
# JWT Secret (use a strong random string in production, min 32 chars)
JWT_SECRET=change_this_to_a_secure_random_string_in_production_min_32_chars

# JWT Access Token expiration (examples: 15m, 1h, 1d)
JWT_ACCESS_EXPIRY=15m

# JWT Refresh Token expiration (examples: 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# Bcrypt salt rounds (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=12

# Session secret (for cookie signing if needed)
SESSION_SECRET=another_secure_random_string_here

# -------------------------------------------
# Admin backoffice credentials (PT-036 / AUD-004)
# -------------------------------------------
# REQUIRED in production. Startup FAILS if these are empty, a known placeholder,
# or the literal default "admin". Development may keep the defaults below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional TOTP second factor for admin login (base32 secret). If set, login requires a code.
# PT-093 (TD-004) — OBLIGATORIO EN PRODUCCION. El arranque se aborta sin el.
# El backoffice aprueba retiros, suspende usuarios y cancela subastas: es el contexto de mas
# privilegio del sistema, y protegerlo solo con contrasena es desproporcionado.
# Minimo 16 caracteres (secreto TOTP base32 de 80 bits; RFC 4226 recomienda 128).
# En desarrollo puede quedar vacio: la carga no compensa para un panel local.
ADMIN_TOTP_SECRET=
# Shared service key between the API and the Admin app. Also gated in production.
ADMIN_API_KEY=dev-admin-key

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# 100 requests per 60 seconds per IP

# Critical endpoints have stricter limits (configured in code)
# - Login: 5 per minute
# - Register: 3 per minute  
# - Bid: 30 per minute

# -------------------------------------------
# pgAdmin (Development Tools)
# -------------------------------------------
PGADMIN_EMAIL=admin@ironloot.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# -------------------------------------------
# Business Rules (configurable)
# -------------------------------------------
# Soft-close window in seconds
AUCTION_SOFT_CLOSE_WINDOW_SEC=120

# Payment expiration in hours
PAYMENT_EXPIRATION_HOURS=72

# Dispute window in days (after delivery)
DISPUTE_WINDOW_DAYS=14
