# =====================================================
# IronLoot - Git Ignore Configuration
# =====================================================
# This .gitignore ensures only essential files are tracked
# - Source code, configuration, migrations
# - Excludes secrets, build artifacts, dependencies, and generated files

# =====================================================
# SECTION 1: ENVIRONMENT & SECRETS
# =====================================================
# Never commit environment variables or credentials
.env
.env.local
.env.*.local
api/.env
api/.env.local
api/.env.*.local
web/.env
web/.env.local
web/.env.*.local
admin/.env
admin/.env.local
admin/.env.*.local

# Sensitive files
*.key
*.pem
*.p8
*.pfx
.ssh/
.credentials/
credentials.json
secrets.json

# =====================================================
# SECTION 2: NODE.JS & DEPENDENCIES
# =====================================================
# Package managers
node_modules/
yarn.lock
pnpm-lock.yaml

# PT-135 — `package-lock.json` YA NO se ignora, y la contradiccion se elimina en vez de declararse
# como excepcion.
#
# Estaba aqui bajo el rotulo «regenerated by npm» — y no lo es: un lock regenerado en otra plataforma
# NO es el mismo lock. Mientras la regla decia que se ignoraban, dos de los tres estaban seguidos
# (raiz y src/api, metidos a la fuerza y sin decision registrada) y el tercero no. `src/admin` fue el
# que pago: su arbol solo existia en la maquina donde nacio.
#
# Una regla que dice lo contrario de lo que el repositorio hace es peor que no tener regla: es una
# trampa para el siguiente que la lea y la respete. Los tres locks son el contrato de
# reproducibilidad, se siguen por git, y se generan DENTRO del contenedor (`npm run lock:api`).
# Lo vigilan `lock-declara-plataformas.spec.ts` y `solo-en-contenedor.js`.
.pnpm-store/

# Dependency cache
npm-debug.log
npm-debug.log*
npm-error.log
npm-error.log*
yarn-debug.log
yarn-error.log

# =====================================================
# SECTION 3: BUILD & COMPILATION ARTIFACTS
# =====================================================
# These are regenerated by npm run build / tsc
dist/
src/api/dist/
src/admin/dist/
src/apps/*/dist/
src/packages/*/dist/
build/
.tsbuildinfo
tsconfig.tsbuildinfo
tsconfig.build.tsbuildinfo
*.tsbuildinfo
*.js
*.d.ts
*.js.map
*.d.ts.map
!*.config.js      # Keep config files
!jest.config.js
!.eslintrc.js
!.prettierrc.js

# PT-088 — El `*.js` de arriba apunta a la salida compilada de TypeScript, pero se llevaba por
# delante el JavaScript del NAVEGADOR, que es codigo fuente y no compilado de nada. Sin esta
# excepcion, un script de front no llega al repositorio: existe en la maquina de quien lo
# escribio y en ninguna otra.
!src/apps/*/public/js/**/*.js

# PT-135 — La misma historia, tercera vez. El utillaje del monorepo tiene que ser JavaScript llano
# porque lo invoca `preinstall`, ANTES de que exista `node_modules` y por tanto antes de que exista
# ts-node. Son codigo fuente, no salida compilada. Y sin esta excepcion la guarda que impide
# instalar en el host se habria quedado en la maquina de quien la escribio — que es exactamente el
# defecto que la guarda existe para impedir.
!scripts/*.js
!src/admin/public/js/**/*.js

# =====================================================
# SECTION 4: IDE & EDITOR
# =====================================================
# Local IDE settings (optional - might keep .vscode/)
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project

# Local Claude Code configuration
.claude/settings.json

# =====================================================
# SECTION 5: TESTING & COVERAGE
# =====================================================
coverage/
.nyc_output/
test-results/
*.lcov
.coverage/
htmlcov/
jest-coverage/

# Test artifacts
*.spec.js
*.test.js
.jest-cache/

# =====================================================
# SECTION 6: DOCUMENTATION & INTERNAL
# =====================================================
# PT-112 (PTSA H-009 + F-37) — Se versiona lo que registra una DECISION.
# No se versiona lo que se puede volver a GENERAR.
#
# Antes era al reves: `docs/` entero fuera -arquitectura, historia de decisiones y la auditoria
# PTSA completa- y `qa-out/` dentro, con 164 MB y 2828 ficheros de capturas de corridas.
#
# El coste de esa inversion, medido: `commits_since_audit` era INDETERMINABLE para los cinco
# documentos que `audit-scope.yaml` declara auditables, asi que la frescura de D4 no se podia
# calcular; la guarda `coherencia-deuda-tecnica.spec.ts` se saltaba a si misma en CI; y las cuatro
# afirmaciones falsas que corrigio PT-109 no dejaron rastro de que decian antes.
#
# Lo que entra son ~3.3 MB de texto. Lo que sale, 164 MB de binarios regenerables.

# --- Artefactos: se regeneran, no se versionan ---
qa-out/
GRAPH_REPORT.md
graphify-out/
graphify-cache/
graphify-temp/
# `implementation/` (sin ruta) se retiro en PT-112: capturaba tambien docs/implementation/,
# que es donde vive la historia de decisiones. No existe un implementation/ en la raiz.

# La evidencia de FDGE mezcla ambas cosas: los .md son razonamiento, el resto son volcados.
docs/implementation/evidence/**
!docs/implementation/evidence/**/
!docs/implementation/evidence/**/*.md

# --- Lo que si se versiona, y por que ---
#   docs/enterprise-documentation/  arquitectura, PRD, TRD, seguridad (lo que audita PTSA)
#   docs/methodology/               los frameworks que gobiernan el trabajo
#   docs/implementation/*.md        HISTORY.log es append-only: es un registro historico
#   changes/                        los Proposal Packages: el razonamiento de cada PT
#   PTSA/                           hallazgos, evidencias y scores: el rastro de auditoria
#   CLAUDE.md                       lo que lee cualquier agente antes de tocar nada

# Local working files
todo.md
*.draft.md
notes/
scratch/

# =====================================================
# SECTION 7: OS & RUNTIME
# =====================================================
# Operating system files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
.metadata
*.sublime-project
*.sublime-workspace

# IDE lock files
.vscode/.settings.json.lock
.idea/.lock

# =====================================================
# SECTION 8: LOGS & TEMPORARY FILES
# =====================================================
# Application logs
logs/
*.log
*.log.*
lerna-debug.log*
lerna.log

# Excepcion declarada: los dos registros append-only de la metodologia NO son logs de aplicacion.
# `HISTORY.log` ya estaba seguido —alguien lo forzo y no lo dejo dicho—, y `ROADMAP_HISTORY.log`
# **nunca lo estuvo**: la misma regla, dos resultados distintos, ninguno declarado. Eso dejaba sin
# rastro cada corrida de FPGE, que es justo lo que el fichero existe para conservar.
# Es la leccion de ADR-048: una regla que dice lo contrario de lo que el repositorio hace es una
# trampa para quien la lea y la respete.
!docs/implementation/HISTORY.log
!docs/implementation/ROADMAP_HISTORY.log

# Temporary files
tmp/
temp/
*.tmp
*.temp
.tmp/

# Docker build cache
.docker-cache/

# Process files
*.pid
*.seed
*.pid.lock

# =====================================================
# SECTION 9: DATABASE & DATA
# =====================================================
# Database files
*.db
*.sqlite
*.sqlite3
database/data/
db/data/
postgres_data/

# Uploads and user-generated content (app-specific)
uploads/
api/uploads/
web/uploads/
admin/uploads/

# Backups
*.backup
*.bak
backup/
backups/

# =====================================================
# SECTION 10: ENVIRONMENT-SPECIFIC
# =====================================================
# Development-only directories
.cache/
.env.development.local
.env.test.local
.env.production.local
.env.qa.local

# Platform-specific
platform-specific/
.AppleDouble
Zone.identifier

# =====================================================
# SECTION 11: VSCODE EXTENSIONS (optional keep this section for settings)
# =====================================================
# Uncomment if you want to share useful extensions list (optional)
# .vscode/extensions.json can be kept

# =====================================================
# EXCEPTIONS - FORCED INCLUSION
# =====================================================
# Use !pattern to force-include files that match a blanket exclude above

# Keep configuration examples and templates
!.env.example
!api/.env.example
!web/.env.example
!admin/.env.example

# Keep Docker and deployment config
!nginx/
!docker-compose.yml
!.github/

# Keep essential build config
!tsconfig.json
!tsconfig.build.json
!jest.config.js
!.eslintrc.js
!.prettierrc

# Keep git-related files
!.gitattributes
!.github/

# Keep husky hooks
!.husky/

# Keep useful IDE defaults
!.vscode/extensions.json
!.vscode/settings.json

QA/
.graphify_*
.antigravitycli/
src/api/generate-pref.ts

# changes/ — versionado desde PT-112: son los Proposal Packages

# =====================================================
# END OF GITIGNORE
# =====================================================

# PT-087 — credenciales de la cuenta personal de sandbox de PayPal (fase QA 71)
tests/qa-browser-suite/paypal-sandbox.json

# PT-112 — `HISTORY.log` es el registro append-only de FDGE, no un log de ejecucion. El patron
# `*.log` lo dejaba fuera pese a ser el documento con mas valor historico del repositorio.
!docs/implementation/HISTORY.log
!PTSA/**/*.log
