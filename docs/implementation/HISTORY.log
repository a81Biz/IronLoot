Modified files: src/apps/client/src/main.ts, src/apps/client/src/common/bff/inject-auth-header.ts (new), src/apps/client/jest.config.js (new), src/apps/client/test/inject-auth-header.spec.ts (new), src/apps/client/package.json, + 8 plantillas views/pages/*
