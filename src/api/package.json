{
  "name": "iron-loot-api",
  "version": "0.5.1",
  "description": "Iron Loot - Plataforma de Subastas Transparentes",
  "author": "Iron Loot Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "audit:baseline": "node -e \"const{execSync}=require('child_process');const fs=require('fs');let o;try{o=execSync('npm audit --omit=dev --json',{encoding:'utf8',maxBuffer:33554432})}catch(e){o=e.stdout}const v=JSON.parse(o).vulnerabilities||{};const a={};for(const[k,x]of Object.entries(v))if((x.via||[]).some(i=>typeof i==='object'))a[k]=x.severity;fs.writeFileSync('security-baseline.json',JSON.stringify({generado:new Date().toISOString().slice(0,10),motivo:'REVISAR: describe por que cada uno sigue aqui',avisos:a},null,2)+'\n');console.log(Object.keys(a).length+' avisos en la linea base')\"",
    "audit:check": "ts-node scripts/audit-check.ts",
    "audit:domain": "ts-node scripts/domain-rules.ts",
    "audit:observability": "ts-node scripts/observability-check.ts",
    "audit:reliability": "ts-node scripts/reliability-check.ts",
    "audit:schema": "ts-node scripts/schema-drift-check.ts",
    "build": "nest build",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "prepare": "cd ../.. && husky install",
    "setup": "cp -n .env.example .env || true && npm install && npx prisma generate",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@ironloot/core": "file:../packages/core",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^5.8.0",
    "@types/cron": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mercadopago": "^2.11.0",
    "nanoid": "^3.3.7",
    "nestjs-throttler-storage-redis": "^0.5.1",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^20.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.module.ts",
      "!src/**/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/test/unit/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "engine.io": ">=6.6.9",
    "lodash": ">=4.18.1",
    "picomatch": ">=4.0.5",
    "qs": ">=6.15.3",
    "socket.io-parser": ">=4.2.7",
    "ws": ">=8.21.1",
    "nodemailer": "$nodemailer",
    "uuid": "^11.1.1",
    "nestjs-throttler-storage-redis": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core"
    },
    "js-yaml": ">=5.2.2",
    "linkify-it": ">=5.0.1",
    "brace-expansion": ">=5.0.8",
    "eslint": {
      "brace-expansion": "^1.1.11"
    }
  }
}
