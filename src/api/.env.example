# ===========================================
# Iron Loot - Environment Configuration
# ===========================================
# Copy this file to .env and adjust values as needed
# NEVER commit .env to version control

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development
# Options: development, qa, production

# -------------------------------------------
# API Configuration
# -------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=ironloot_db
DB_USER=ironloot
DB_PASSWORD=ironloot_dev

# Full connection URL (auto-constructed in docker-compose)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -------------------------------------------
# Redis
# -------------------------------------------
# PT-137 — `REDIS_URL` es el UNICO contrato de Redis. `REDIS_HOST`/`REDIS_PORT` se retiraron.
# REDIS_PASSWORD=  # Uncomment if Redis auth is enabled

# Full connection URL
REDIS_URL=redis://redis:6379

# -------------------------------------------
# Logging & Observability
# -------------------------------------------
LOG_LEVEL=debug
# Options: debug, info, warn, error
# Note: debug is only enabled in development

TRACE_ENABLED=true
# Enable trace_id propagation

# -------------------------------------------
# Security & Authentication
# -------------------------------------------
# JWT Secret (use a strong random string in production)
JWT_SECRET=change_this_to_a_secure_random_string_in_production_min_32_chars

# JWT Access Token expiration (examples: 15m, 1h, 1d)
JWT_ACCESS_EXPIRY=15m

# JWT Refresh Token expiration (examples: 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# Bcrypt salt rounds (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=12

# Session secret (for cookie signing if needed)
SESSION_SECRET=another_secure_random_string_here

# -------------------------------------------
# Admin backoffice credentials (PT-036 / AUD-004)
# -------------------------------------------
# REQUIRED in production. Startup FAILS if these are empty, a known placeholder,
# or the literal default "admin". Development may keep the defaults below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional TOTP second factor for admin login (base32 secret). If set, login requires a code.
ADMIN_TOTP_SECRET=
# Shared service key between the API and the Admin app. Also gated in production.
ADMIN_API_KEY=dev-admin-key

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200
# 200 requests per 60 seconds per IP (global default — supports BASE catalog traffic)
# Specific lower limits apply to: auth (5-30/min), webhooks (20/min), wallet (5-10/min)

# Critical endpoints have stricter limits (configured in code)
# - Login: 5 per minute
# - Register: 3 per minute  
# - Bid: 30 per minute

# -------------------------------------------
# pgAdmin (Development Tools)
# -------------------------------------------
PGADMIN_EMAIL=admin@ironloot.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# -------------------------------------------
# Business Rules (configurable)
# -------------------------------------------
# Soft-close window in seconds
AUCTION_SOFT_CLOSE_WINDOW_SEC=120

# Payment expiration in hours
PAYMENT_EXPIRATION_HOURS=72

# Dispute window in days (after delivery)
DISPUTE_WINDOW_DAYS=14

# -------------------------------------------
# Payment Providers
# -------------------------------------------
# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN="YOUR_MP_ACCESS_TOKEN"
MERCADO_PAGO_WEBHOOK_SECRET="YOUR_MP_WEBHOOK_SECRET"

# PayPal
# PayPal — Orders v2 API + Webhooks (PT-076).
# Client ID y Secret: developer.paypal.com -> Apps & Credentials -> Sandbox -> tu app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID: en la app -> Webhooks -> Add Webhook (URL publica HTTPS + /payments/webhook/PAYPAL,
# suscrito a CHECKOUT.ORDER.APPROVED y PAYMENT.CAPTURE.COMPLETED). Formato 0NH55953DH663215D.
# Obligatorio: sin el no se puede verificar la firma de los webhooks.
PAYPAL_WEBHOOK_ID=
# OBSOLETA (PT-076): era un parametro del formulario WPS legacy. Orders v2 no la usa.
# Se conserva para no romper entornos desplegados que aun la definan.
PAYPAL_BUSINESS_EMAIL=merchant@example.com
PAYPAL_MODE=sandbox

# Base URLs
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Phase 2 — Multi-service architecture (PT-015 activated)
# ─────────────────────────────────────────────────────────────

# Feature Flags
BASE_ENABLED=true
CLIENT_ENABLED=true
ADMIN_ENABLED=true

# Service URLs
# Development (Docker / local): use subdomain pattern (add to hosts file)
#   127.0.0.1  base.localhost
#   127.0.0.1  client.localhost
#   127.0.0.1  api.localhost
#   127.0.0.1  admin.localhost
# Production: replace with real HTTPS URLs
BASE_URL=http://base.localhost
CLIENT_URL=http://client.localhost
ADMIN_URL=http://admin.localhost
API_URL=http://api.localhost

# Cookie configuration (cross-subdomain SSO)
# ─── COOKIE_DOMAIN options ────────────────────────────────────────────────────
# Local dev with *.localhost subdomains:
#   Chrome ≥ 90 does NOT share cookies between base.localhost and client.localhost
#   when domain=localhost (without dot). Options:
#
#   Option A — No cross-subdomain SSO (simplest, each subdomain gets its own session):
#     COOKIE_DOMAIN=       (empty — browser scopes cookie to the emitting host)
#
#   Option B — Cross-subdomain SSO with custom .local domain:
#     Add to /etc/hosts:  127.0.0.1 ironloot.local base.ironloot.local client.ironloot.local
#     Set:                COOKIE_DOMAIN=.ironloot.local
#     This reliably shares cookies across all subdomains (works in all browsers).
#
#   Option C — Firefox-only local dev (domain=localhost):
#     COOKIE_DOMAIN=localhost   ← works in Firefox, NOT in Chrome ≥ 90
#
#   Production (HTTPS):
#     COOKIE_DOMAIN=.ironloot.com   (with leading dot — share across all *.ironloot.com)
#
#   → See SSO validation runbook: implementation/SSO_VALIDATION_RUNBOOK.md
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax
# Set to true only in production (HTTPS required)
COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins
# Includes: web/ legacy (5173), apps/base local (5174), apps/client local (5175), admin local (3001)
# Plus Nginx subdomains: base.localhost, client.localhost, admin.localhost
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3001,http://base.localhost,http://base.localhost:5174,http://client.localhost,http://client.localhost:5175,http://admin.localhost

# ==============================================================================
# PT-137 — Variables que el API LEE y no estaba declaradas en ningun sitio
# ==============================================================================
#
# Las encontro la guarda `variables-de-entorno-declaradas.spec.ts`: veinticinco
# variables que el codigo lee y que no aparecian en `.env.example` ni en el de la
# raiz, ni siquiera comentadas.
#
# Eso es el mismo defecto que F-135-A en pequeno: si el sistema depende de algo
# que no esta declarado, lo que lo hace funcionar es el fichero `.env` de alguien
# — y ese fichero no esta en git.
#
# Van COMENTADAS a proposito. Comentar es como se dice «opcional, o depende de
# una integracion que no todo el mundo activa». Activarlas obligaria a inventar
# credenciales de terceros, que seria peor que el problema. Lo que importa es que
# quede escrito que existen.
#
# Donde el codigo ya tiene un valor por defecto, se anota cual: es informacion
# leida del codigo, no elegida aqui.

# --- Identidad -----------------------------------------------------------------
# APP_NAME=IronLoot

# --- JWT: caducidades ----------------------------------------------------------
# JWT_EXPIRATION=
# JWT_EXPIRES_IN=1h                    # valor por defecto en el codigo
# JWT_REFRESH_EXPIRATION=7d            # valor por defecto en el codigo

# --- Correo saliente -----------------------------------------------------------
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@ironloot.local

# --- Mercado Pago: lo que faltaba ----------------------------------------------
# MERCADO_PAGO_SANDBOX=true
# MERCADO_PAGO_NOTIFICATION_URL=

# --- Pasarelas sin contratar (TD-002) ------------------------------------------
# Stripe y HeyBanco estan bloqueadas por credenciales; se declaran para que se sepa
# que el codigo las lee.
# STRIPE_SECRET_KEY=
# HEY_BANCO_API_URL=https://api.hey.inc/v1   # valor por defecto en el codigo
# HEY_BANCO_CLIENT_ID=
# HEY_BANCO_CLIENT_SECRET=
# HEY_BANCO_WEBHOOK_SECRET=

# --- CFDI (TD-001, H-005: bloqueado por decision de negocio) --------------------
# CFDI_ENABLED=false
# CFDI_PAC_URL=
# CFDI_RFC_EMISOR=

# --- reCAPTCHA -----------------------------------------------------------------
# RECAPTCHA_ENABLED=false
# RECAPTCHA_SECRET=

# --- Reglas de negocio y operacion ---------------------------------------------
# REQUIRE_AUCTION_MODERATION=false
# WITHDRAWAL_DAILY_LIMIT=
# LOG_RETENTION_DAYS=
# SLOW_REQUEST_THRESHOLD_MS=3000       # valor por defecto en el codigo
