# ===========================================
# Iron Loot API - Development Dockerfile
# ===========================================
# Using Debian slim instead of Alpine for better Prisma compatibility
FROM node:20-slim

# Install dependencies for native modules and utilities
RUN apt-get update && apt-get install -y \
    openssl \
    python3 \
    make \
    g++ \
    git \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# PT-135 — `npm ci`, no `npm install`.
#
# Con `npm install` el lock era una sugerencia: cada build volvia a resolver y el fichero no gobernaba
# nada. `npm ci` instala EXACTAMENTE el arbol del lock, o falla.
#
# Matiz honesto, para que nadie lo lea al reves: `npm ci` **no** habria evitado el defecto de PT-135.
# Instala el lock, y el lock estaba mal — le faltaban los binarios de Linux por haberse generado en
# Windows. Lo que impide eso es `scripts/solo-en-contenedor.js`, y lo que lo caza es
# `lock-declara-plataformas.spec.ts`. Esta linea sirve para otra cosa: que el lock mande de verdad.
RUN npm ci

# Copy Prisma schema and generate client
COPY prisma ./prisma
RUN npx prisma generate

# Copy NestJS configuration files
COPY tsconfig*.json ./
COPY nest-cli.json ./

# Copy scripts
COPY scripts ./scripts
RUN chmod +x ./scripts/*.sh

# Copy source code
COPY src ./src

# Expose API port
EXPOSE 3000

# Use entrypoint script for migrations
ENTRYPOINT ["./scripts/entrypoint.dev.sh"]
